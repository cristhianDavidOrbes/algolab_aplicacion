  m_Script: {fileID: 11500000, guid: cfb8300648f2cc04f870246ca003bdae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AlgoLabPillarLevelController
  niveles:
  - numeroNivel: 3
    nombre: Encapsulamiento
    explicacion: "Una clase protege su estado interno y expone solo operaciones seguras.
      Los datos privados no se manipulan directamente: se validan mediante m\xE9todos
      p\xFAblicos."
    reto: 'Repara el Robot usando solo sus metodos publicos. Protege energia, temperatura,
      encendido y averia: intentar modificar directamente un atributo privado resta
      puntos.'
  - numeroNivel: 4
    nombre: "Abstracci\xF3n"
    explicacion: "La abstracci\xF3n muestra lo esencial y oculta detalles que no
      necesita quien utiliza el objeto. Una interfaz simple permite usar una clase
      sin conocer toda su implementaci\xF3n."
    reto: "Separa las operaciones esenciales de Veh\xEDculo de los detalles internos
      necesarios para realizarlas."
  - numeroNivel: 5
    nombre: Herencia
    explicacion: "Una clase hija reutiliza la estructura de una clase padre y puede
      especializarla. As\xED Carro, Moto y Cami\xF3n comparten lo que corresponde
      a Veh\xEDculo."
    reto: "Clasifica qu\xE9 atributos y m\xE9todos pertenecen a Veh\xEDculo y cu\xE1les
      son espec\xEDficos de Carro, Moto o Cami\xF3n."
  - numeroNivel: 6
    nombre: Polimorfismo
    explicacion: "Una misma operaci\xF3n puede producir un comportamiento distinto
      seg\xFAn el objeto que la ejecuta. Una referencia com\xFAn permite trabajar
      con varias implementaciones."
    reto: "Relaciona acelerar() con la implementaci\xF3n de Carro, Moto o Cami\xF3n
      y explica por qu\xE9 cambia la respuesta."
  encapsulationThemeController: {fileID: 386947831}
  abstractionThemeController: {fileID: 596282735}
  OnTemaTerminado:
    m_PersistentCalls:
      m_Calls: []
  tutorialPracticaNivel3: {fileID: 1754380339}
  recursoPracticaRobot: Level3/AlgoLabRobotPractice
  manualSpawner: {fileID: 0}
  mostrarDebug: 1
